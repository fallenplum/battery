{
  "seed": 42,
  "epochs": 150,
  "batch_size": 8,
  "learning_rate": 0.0003,
  "weight_decay": 0.01,
  "gradient_clip": 1.0,
  "width": 64,
  "domains": ["MATR", "HUST"],
  "folds": ["cell_fold_0", "cell_fold_1", "cell_fold_2", "cell_fold_3", "cell_fold_4"],
  "arms": {
    "D1-G": {"features": "G", "decoder": "query_mlp", "rate_weight": 0.0},
    "D1-L": {"features": "L", "decoder": "query_mlp", "rate_weight": 0.0},
    "D1-GL": {"features": "GL", "decoder": "query_mlp", "rate_weight": 0.0},
    "D1-0-capmatch": {"features": "capacity", "decoder": "query_mlp", "rate_weight": 0.0},
    "D2-F0L1": {"features": "none", "decoder": "query_mlp", "rate_weight": 0.1},
    "D2-F1L1": {"features": "GL", "decoder": "query_mlp", "rate_weight": 0.1},
    "D2-GL-rate-spline": {"features": "GL", "decoder": "monotone_spline", "rate_weight": 0.1},
    "D2-GL-rate-physics": {"features": "GL", "decoder": "physics_basis", "rate_weight": 0.1}
  },
  "fusion": "residual_add_after_raw_encoder",
  "missingness": "union_cohort_no_cell_dropped_zero_invalid_values_plus_explicit_masks",
  "feature_scaler": "fold_train_supported_population_per_channel_sd_floor_1e-5",
  "selection": "first_strict_minimum_own_fold_validation_trajectory_mae",
  "rate_endpoints": [[200,500],[500,1000]],
  "rate_scale": 1000,
  "endpoint_float32_tolerance": 5e-10,
  "oracle": {
    "families": ["physics_free", "spline10", "positive_rate8", "polynomial4", "linear1", "physics_shared"],
    "starts": 8,
    "maxiter": 500,
    "ftol": 1e-12,
    "gtol": 1e-7,
    "shared_train_maxiter": 400,
    "spline_knots_u": [0,0.5,1,1.5,2,2.5,3,3.5,4,4.5,5],
    "positive_rate_knots_u": [0,0.375,0.75,1.125,1.5,1.875,2.25,2.625,3],
    "near_equivalent_relative": 0.05,
    "near_equivalent_absolute": 0.002,
    "sensitivity_relative": [0.01,0.05,0.10],
    "tau_profile_u": [0.25,0.5,1,1.5,2,2.5,3,3.75],
    "amplitude_profile": [0.001,0.01,0.03,0.06,0.12,0.3],
    "rate_profile_scaled": [0,0.02,0.05,0.1,0.2,0.4],
    "svd_scaled_parameter_step": [0.05,0.05,0.06,1,0.5,0.25],
    "profile_cells": "first_three_sorted_train_UIDs_and_first_three_sorted_OOF_test_UIDs_each_domain_fold0",
    "jacobian_near_zero_relative": 1e-6,
    "followup_short_cycle": 1000
  },
  "proxy": {
    "model": "Ridge",
    "alphas": [0.01,0.1,1,10,100,1000],
    "selection": "train_fit_validation_per_window_mae_then_no_trainval_refit",
    "raw_statistics": "masked_channel_mean_sd_and_cycle_1_20_to_81_100_mean_difference",
    "physics_statistics": "per_channel_masked_cycle_mean_sd_and_early_late_difference_plus_support_fraction",
    "z_arms": ["D1-GL", "D2-F1L1", "D2-GL-rate-physics"]
  },
  "bootstrap": {"draws": 2000, "seed": 42, "units": ["physical_cell","protocol"]},
  "causal_threshold": {"descriptive_oracle_low_mae": 0.01, "minimum_effect_mae": 0.001},
  "scope": "single_seed_retrospective_exposed_cohorts_no_new_blind_test"
}
